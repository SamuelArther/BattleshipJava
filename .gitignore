# Compiled output (regenerate with: javac -d out $(find src -name "*.java"))
# out/ is included in releases so run.ps1 works immediately after cloning.
# Uncomment if you prefer not to track class files:
# out/

# JavaFX SDK (download from https://openjfx.io)
javafx-sdk-lib/

