Setup.exe
Battleship.exe

# IExpress packaging artifacts
package/
~*.DDF
*.sed

# JavaFX path cache (auto-generated by run.ps1)
.javafx_path

# Debug / log files
debug_*.ps1
debug_*_out.txt
run_debug.txt
play_log.txt

# Windows junk
desktop.ini
Thumbs.db

# Old release zips
*.zip

# Claude AI session data
.claude/
